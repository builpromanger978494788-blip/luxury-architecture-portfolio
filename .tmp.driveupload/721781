<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <!-- Background -->
  <rect width="100" height="100" fill="#ffffff" />
  
  <!-- Outer Box -->
  <rect x="2" y="2" width="96" height="96" fill="none" stroke="#000000" stroke-width="2" />
  
  <!-- Diagonals and Cross -->
  <line x1="2" y1="2" x2="98" y2="98" stroke="#000000" stroke-width="1.5" />
  <line x1="2" y1="98" x2="98" y2="2" stroke="#000000" stroke-width="1.5" />
  <line x1="50" y1="2" x2="50" y2="98" stroke="#000000" stroke-width="1.5" />
  <line x1="2" y1="50" x2="98" y2="50" stroke="#000000" stroke-width="1.5" />

  <!-- Corner Circles -->
  <g fill="none" stroke="#000000" stroke-width="2">
    <!-- Top Left -->
    <circle cx="15" cy="15" r="3.5" />
    <circle cx="15" cy="15" r="7.5" />
    <circle cx="15" cy="15" r="12" />
    
    <!-- Top Right -->
    <circle cx="85" cy="15" r="3.5" />
    <circle cx="85" cy="15" r="7.5" />
    <circle cx="85" cy="15" r="12" />
    
    <!-- Bottom Left -->
    <circle cx="15" cy="85" r="3.5" />
    <circle cx="15" cy="85" r="7.5" />
    <circle cx="15" cy="85" r="12" />
    
    <!-- Bottom Right -->
    <circle cx="85" cy="85" r="3.5" />
    <circle cx="85" cy="85" r="7.5" />
    <circle cx="85" cy="85" r="12" />
  </g>

  <!-- Petals -->
  <g fill="none" stroke="#000000" stroke-width="2">
    <!-- Straight Petals -->
    <path d="M 50 50 A 28 28 0 0 1 50 2 A 28 28 0 0 1 50 50" />
    <path d="M 50 50 A 28 28 0 0 1 50 2 A 28 28 0 0 1 50 50" transform="rotate(90 50 50)" />
    <path d="M 50 50 A 28 28 0 0 1 50 2 A 28 28 0 0 1 50 50" transform="rotate(180 50 50)" />
    <path d="M 50 50 A 28 28 0 0 1 50 2 A 28 28 0 0 1 50 50" transform="rotate(270 50 50)" />

    <!-- Diagonal Petals -->
    <path d="M 50 50 A 21 21 0 0 1 50 14.5 A 21 21 0 0 1 50 50" transform="rotate(45 50 50)" />
    <path d="M 50 50 A 21 21 0 0 1 50 14.5 A 21 21 0 0 1 50 50" transform="rotate(135 50 50)" />
    <path d="M 50 50 A 21 21 0 0 1 50 14.5 A 21 21 0 0 1 50 50" transform="rotate(225 50 50)" />
    <path d="M 50 50 A 21 21 0 0 1 50 14.5 A 21 21 0 0 1 50 50" transform="rotate(315 50 50)" />
  </g>
</svg>
